{
  "name": "wethepeople",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:gen": "node scripts/gen-tests.mjs",
    "eval": "node scripts/eval.mjs",
    "lint": "node --check src/worker.js && node --check src/identity.js && for f in lib/*.mjs lib/*/*.mjs scripts/*.mjs; do node --check $f || exit 1; done",
    "build:llms": "node scripts/build-llms.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  }
}
